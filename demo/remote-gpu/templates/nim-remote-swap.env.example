# Copy to:   ~/.config/nim-remote-swap.env
# Then:      chmod 600 ~/.config/nim-remote-swap.env
#
# Replace every placeholder with your real values. Do not commit the filled file.

# ── Required ─────────────────────────────────────────────────────────
export NIM_GPU_IP="<gpu-instance-ip>"        # Global IP of the GPU instance
export NGC_API_KEY="nvapi-..."               # NGC API key for NIM containers

# ── Optional ─────────────────────────────────────────────────────────
# export NIM_GPU_HOST="nim-gpu"              # SSH host alias (default: nim-gpu)
