# NemoClaw Voice Guide Demo environment
# Install target:
#   ~/.config/nemoclaw-voice-agent/voice-agent.env

# Required for NVIDIA-hosted LLM, ASR, and TTS services.
NVIDIA_API_KEY=

# Bridge runtime.
OPENCLAW_BRIDGE_HOST=127.0.0.1
OPENCLAW_BRIDGE_PORT=8787
OPENCLAW_BRIDGE_TIMEOUT_SEC=180
OPENCLAW_BRIDGE_SANDBOX=

# Planner runtime. install.sh sets these to the selected sandbox.
PLANNER_SANDBOX_NAME=
PLANNER_BACKEND=auto
PLANNER_AGENT_NAME=main
PLANNER_TIMEOUT_SEC=150
OPENCLAW_GATEWAY_AUTOSTART=true
OPENCLAW_DIRECT_FALLBACK=true

# Optional explicit host IP used when rendering example policy/templates.
HOST_IP=

# VoiceChat NIM.
VOICECHAT_BASE_URL=
VOICECHAT_MODEL=nvidia/nemotron-3-voicechat-12b

# PersonaPlex NIM.
PERSONAPLEX_BASE_URL=
PERSONAPLEX_MODEL=nvidia/personaplex-7b-v1

# Upstream voice-agent-examples checkout and launch command, if used.
UPSTREAM_VOICE_AGENT_DIR=
UPSTREAM_VOICE_APP_CMD=

# Bridge callback URL for the voice layer.
OPENCLAW_BRIDGE_QUERY_URL=http://127.0.0.1:8787/agent/query

# LLM configuration.
NVIDIA_LLM_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b
TEMPERATURE=1.0
TOP_P=1.0
MAX_TOKENS=2048
ENABLE_THINKING=false

# ASR configuration.
ASR_SERVER_URL=grpc.nvcf.nvidia.com:443
ASR_CLOUD_FUNCTION_ID=1598d209-5e27-4d3c-8079-4751568b1081
ASR_MODEL_NAME=parakeet-1.1b-en-US-asr-streaming-silero-vad-sortformer
ASR_LANGUAGE=en-US

# TTS configuration.
TTS_SERVER_URL=grpc.nvcf.nvidia.com:443
TTS_VOICE_ID=Magpie-Multilingual.EN-US.Aria
TTS_MODEL_NAME=magpie_tts_ensemble-Magpie-Multilingual
TTS_LANGUAGE=en-US
ENABLE_TTS_TEXT_FILTER=true

# WebRTC TURN configuration. Leave blank for local testing without TURN.
TURN_SERVER_URL=
TURN_USERNAME=
TURN_PASSWORD=

# Demo behavior and local assets.
ENABLE_MULTILINGUAL=false
ENABLE_SPECULATIVE_SPEECH=true
VAD_PROFILE=ASR
CHAT_HISTORY_LIMIT=20
SYSTEM_PROMPT_SELECTOR=nemotron-3-nano/generic_voice_assistant
PROMPT_FILE_PATH=prompt.yaml
JEWEL_DATA_PATH=jewel_knowledge.json
TTS_IPA_FILE_PATH=ipa.json

# Debugging.
ENABLE_ASR_AUDIO_DUMP=false
ENABLE_TTS_AUDIO_DUMP=false
AUDIO_DUMP_PATH=voice_agent_webrtc/audio_dumps
