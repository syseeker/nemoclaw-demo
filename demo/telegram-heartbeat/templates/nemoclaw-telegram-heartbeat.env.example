# Copy to:   ~/.config/nemoclaw-telegram-heartbeat.env
# Then:      chmod 600 ~/.config/nemoclaw-telegram-heartbeat.env
#
# Replace every placeholder with your real values. Do not commit the filled file.
# Inference credentials are managed by the OpenShell gateway — no API key needed here.

export TELEGRAM_BOT_TOKEN="your-bot-token-from-botfather"
export TELEGRAM_CHAT_ID="381233314"
export SANDBOX_NAME="nemoclaw"

# Optional
# export HEARTBEAT_TIMEOUT_SEC=5
