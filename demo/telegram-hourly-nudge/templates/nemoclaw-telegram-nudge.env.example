# Copy to:   ~/.config/nemoclaw-telegram-nudge.env
# Then:     chmod 600 ~/.config/nemoclaw-telegram-nudge.env
#
# Replace every placeholder with your real values. Do not commit the filled file.

export TELEGRAM_BOT_TOKEN="your-bot-token-from-botfather"
export TELEGRAM_NUDGE_CHAT_ID="-1001234567890"
export NVIDIA_API_KEY="nvapi-..."
export SANDBOX_NAME="your-sandbox"
export PHILOSOPHER_THEME="life"
export PHILOSOPHER_NUDGE_TZ="Asia/Singapore"

# Optional — hourly message footer and logging
# export TELEGRAM_NUDGE_REPLY_HINT=0
# export TELEGRAM_NUDGE_REPLY_HINT_TEXT="Reply here to chat with the assistant."
# export TELEGRAM_NUDGE_SILENT=1
# export RUN_PHILOSOPHER_NUDGE_TIMEOUT_SEC=300

# Optional — only if you also `source` this file before `nemoclaw start` (bridge)
# export ALLOWED_CHAT_IDS="-1001234567890,987654321"
