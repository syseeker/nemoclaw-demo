# Copy to:   ~/.config/nemoclaw-telegram-nudge.env
# Then:      chmod 600 ~/.config/nemoclaw-telegram-nudge.env
#
# Replace every placeholder with your real values. Do not commit the filled file.

# ── Required ─────────────────────────────────────────────────────────
export TELEGRAM_BOT_TOKEN="your-bot-token-from-botfather"
export TELEGRAM_NUDGE_CHAT_ID="-1001234567890"
export NVIDIA_API_KEY="nvapi-..."
export SANDBOX_NAME="your-sandbox"

# ── Philosopher nudge (run_philosopher_nudge_llm.sh) ─────────────────
# Only needed if using the philosopher nudge; ignore if using joke nudge.
export PHILOSOPHER_THEME="life"                   # life | work | games | love | hobby | nature | custom text
export PHILOSOPHER_NUDGE_TZ="Asia/Singapore"      # IANA tz for the "Ting tong, <time>" stamp
# export RUN_PHILOSOPHER_NUDGE_TIMEOUT_SEC=180    # max seconds to wait for the LLM

# ── Chinese jokes nudge (run_joke_nudge_llm.sh) ─────────────────────
# Only needed if using the joke nudge; ignore if using philosopher nudge.
# export JOKE_TOPIC=""                            # e.g. 方言梗, 吃的, 家庭, 生活 — leave empty for random
# export RUN_JOKE_NUDGE_TIMEOUT_SEC=180           # max seconds to wait for the LLM

# ── Telegram message options ─────────────────────────────────────────
# export TELEGRAM_NUDGE_REPLY_HINT=0              # set to 0 to drop the "you can reply" footer
# export TELEGRAM_NUDGE_REPLY_HINT_TEXT="Reply here to chat with the assistant."
# export TELEGRAM_NUDGE_SILENT=1                  # hide the OK line in logs

# ── NemoClaw bridge (nemoclaw start) ─────────────────────────────────
# Only if you also `source` this file before running the bridge.
# export ALLOWED_CHAT_IDS="-1001234567890,987654321"
